ENVIRONMENT=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/duocone
JWT_SECRET=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# create any missing tables on startup (dev bridge until Alembic migrations exist)
AUTO_CREATE_TABLES=true
AUTO_SEED=true

# CMS admin: provisioned/refreshed on startup when both are set (hosts w/o shell).
# Locally you can instead run: python -m scripts.create_admin --email ... --password ...
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
IMAGE_BASE_URL=https://raw.githubusercontent.com/duocone/product-images/main/
FRONTEND_URL=http://localhost:5173

# Stripe — leave blank to disable card payments (checkout falls back to invoice)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# EMAIL_PROVIDER: sendgrid | mailgun | smtp  (blank creds -> logs to console)
EMAIL_PROVIDER=smtp
SENDGRID_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_SSL=false
EMAIL_FROM=no-reply@duo-cone.com
EMAIL_FROM_NAME=DuoCone
SALES_EMAIL=sales@duo-cone.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
LLM_API_KEY=
WOO_BASE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
